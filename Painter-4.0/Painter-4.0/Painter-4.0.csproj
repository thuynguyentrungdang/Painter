<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Painter</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Library</OutputType>
        <Nullable>enable</Nullable>
        <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <LangVersion>latest</LangVersion>
        <Version>2.0.1</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SPTushonka.Common" Version="4.1.*"/>
        <PackageReference Include="SPTushonka.DI" Version="4.1.*"/>
        <PackageReference Include="SPTushonka.Server.Core" Version="4.1.*"/>
        <PackageReference Include="WTT-ServerCommonLib" Version="3.0.6" />
    </ItemGroup>

    <PropertyGroup>
        <SPTPath>F:\SPT_4.1_Server\SPT_Runtime</SPTPath>
    </PropertyGroup>

    <Target Name="DebugCopy" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">

        <!-- Destination for debug builds -->
        <PropertyGroup>
            <DebugStaging>$(SPTPath)\user\mods\$(ProjectName)</DebugStaging>
        </PropertyGroup>

        <MakeDir Directories="$(DebugStaging)"/>

        <ItemGroup>
            <!-- Copy all DLLs produced by the build -->
            <DebugDlls Include="$(OutputPath)*.dll"/>
            
            <!-- Copy all bundle files -->
            <BundlesFolder Include="$(MSBuildProjectDirectory)\bundles\**\*.*"/>

            <!-- Copy all database files -->
            <DatabaseFolder Include="$(MSBuildProjectDirectory)\db\**\*.*"/>
            
            <!-- Copy all resource files -->
            <ResFolder Include="$(MSBuildProjectDirectory)\res\**\*.*"/>
        </ItemGroup>

        <Message Importance="high" Text="Debug build detected. Copying files to $(DebugStaging)"/>

        <Copy
                SourceFiles="@(DebugDlls)"
                DestinationFolder="$(DebugStaging)"
                SkipUnchangedFiles="false"
                ContinueOnError="false"/>

        <Copy
                SourceFiles="@(BundlesFolder)"
                DestinationFiles="@(BundlesFolder->'$(DebugStaging)\bundles\%(RecursiveDir)\%(Filename)%(Extension)')"
                SkipUnchangedFiles="false"
                ContinueOnError="false"/>

        <Copy
                SourceFiles="@(DatabaseFolder)"
                DestinationFiles="@(DatabaseFolder->'$(DebugStaging)\db\%(RecursiveDir)\%(Filename)%(Extension)')"
                SkipUnchangedFiles="false"
                ContinueOnError="false"/>
        
        <Copy
                SourceFiles="@(ResFolder)"
                DestinationFiles="@(ResFolder->'$(DebugStaging)\res\%(RecursiveDir)\%(Filename)%(Extension)')"
                SkipUnchangedFiles="false"
                ContinueOnError="false"/>

    </Target>

    <!-- Copy output to staging directory (local dev only, skipped on CI - no D:\ drive there) -->
    <Target Name="StagingForge" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(CI)' != 'true'">

        <!-- Build the full staging path -->
        <PropertyGroup>
            <StagingDir>D:\Staging Area\$(ProjectName)\SPT_Runtime\user\mods\$(ProjectName)</StagingDir>
        </PropertyGroup>

        <!-- Create directory if missing -->
        <MakeDir Directories="$(StagingDir)" Condition="!Exists('$(StagingDir)')"/>

        <!-- Collect DLLs -->
        <ItemGroup>
            <!-- Copy all DLLs produced by the build -->
            <DllFiles Include="$(OutputPath)*.dll"/>

            <!-- Copy all bundle files -->
            <BundlesFolder Include="$(MSBuildProjectDirectory)\bundles\**\*.*"/>

            <!-- Copy all database files -->
            <DatabaseFolder Include="$(MSBuildProjectDirectory)\db\**\*.*"/>

            <!-- Copy all resource files -->
            <ResFolder Include="$(MSBuildProjectDirectory)\res\**\*.*"/>
        </ItemGroup>

        <Message Importance="high" Text="Copying DLLs to staging: $(StagingDir)"/>

        <!-- Copy DLLs -->
        <Copy
                SourceFiles="@(DllFiles)"
                DestinationFolder="$(StagingDir)"
                SkipUnchangedFiles="true"
                ContinueOnError="false"/>

        <Copy
                SourceFiles="@(BundlesFolder)"
                DestinationFiles="@(BundlesFolder->'$(StagingDir)\bundles\%(RecursiveDir)\%(Filename)%(Extension)')"
                SkipUnchangedFiles="false"
                ContinueOnError="false"/>

        <Copy
                SourceFiles="@(DatabaseFolder)"
                DestinationFiles="@(DatabaseFolder->'$(StagingDir)\db\%(RecursiveDir)\%(Filename)%(Extension)')"
                SkipUnchangedFiles="false"
                ContinueOnError="false"/>

        <Copy
                SourceFiles="@(ResFolder)"
                DestinationFiles="@(ResFolder->'$(StagingDir)\res\%(RecursiveDir)\%(Filename)%(Extension)')"
                SkipUnchangedFiles="false"
                ContinueOnError="false"/>

        <Message Importance="high" Text="Staging complete."/>

    </Target>

    <!-- Zip a release-ready package (user\mods\$(ProjectName)\...) into artifacts\ -->
    <Target Name="Package" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">

        <PropertyGroup>
            <PackageRoot>$(MSBuildProjectDirectory)\artifacts\$(ProjectName)-$(Version)</PackageRoot>
            <PackageModDir>$(PackageRoot)\user\mods\$(ProjectName)</PackageModDir>
            <PackageZipPath>$(MSBuildProjectDirectory)\artifacts\$(ProjectName)-$(Version).zip</PackageZipPath>
        </PropertyGroup>

        <RemoveDir Directories="$(PackageRoot)" Condition="Exists('$(PackageRoot)')"/>
        <Delete Files="$(PackageZipPath)" Condition="Exists('$(PackageZipPath)')"/>
        <MakeDir Directories="$(PackageModDir)"/>

        <ItemGroup>
            <PackageDlls Include="$(OutputPath)*.dll"/>
            <PackageBundles Include="$(MSBuildProjectDirectory)\bundles\**\*.*"/>
            <PackageDb Include="$(MSBuildProjectDirectory)\db\**\*.*"/>
            <PackageRes Include="$(MSBuildProjectDirectory)\res\**\*.*"/>
        </ItemGroup>

        <Copy
                SourceFiles="@(PackageDlls)"
                DestinationFolder="$(PackageModDir)"
                SkipUnchangedFiles="false"
                ContinueOnError="false"/>

        <Copy
                SourceFiles="@(PackageBundles)"
                DestinationFiles="@(PackageBundles->'$(PackageModDir)\bundles\%(RecursiveDir)\%(Filename)%(Extension)')"
                SkipUnchangedFiles="false"
                ContinueOnError="false"/>

        <Copy
                SourceFiles="@(PackageDb)"
                DestinationFiles="@(PackageDb->'$(PackageModDir)\db\%(RecursiveDir)\%(Filename)%(Extension)')"
                SkipUnchangedFiles="false"
                ContinueOnError="false"/>

        <Copy
                SourceFiles="@(PackageRes)"
                DestinationFiles="@(PackageRes->'$(PackageModDir)\res\%(RecursiveDir)\%(Filename)%(Extension)')"
                SkipUnchangedFiles="false"
                ContinueOnError="false"/>

        <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="$(PackageZipPath)" Overwrite="true"/>

        <Message Importance="high" Text="Packaged release zip: $(PackageZipPath)"/>

    </Target>

</Project>
